<?xml version="1.0"?>

<launch>

  <arg name="frame_id"              default="bynav_link" />
  <arg name="ip_address"            default="192.168.0.102" />
  <arg name="port"                  default="1111" />
  <arg name="publish_extended_data" default="true" />
  <arg name="print_debug_info"      default="false" />

  <arg name="gnss_topic" default="/agribot/gnss/bynav"/>
  <arg name="heading_topic" default="/agribot/heading/bynav"/>
  <arg name="gnss_extended_topic" default="/agribot/gnss/bynav/extended"/>
  <arg name="heading_extended_topic" default="/agribot/heading/bynav/extended"/>

  <node pkg="hal_bynav" type="hal_bynav_node" name="hal_bynav_node">
    <param name="frame_id" value="$(arg frame_id)" />
    <param name="ip_address" value="$(arg ip_address)" />
    <param name="port" value="$(arg port)" />
    <param name="publish_extended_data" value="$(arg publish_extended_data)" />
    <param name="print_debug_info" value="$(arg print_debug_info)" />

    <remap from="~gnss" to="$(arg gnss_topic)"/>
    <remap from="~heading" to="$(arg heading_topic)"/>
    <remap from="~gnss/extended" to="$(arg gnss_extended_topic)"/>
    <remap from="~heading/extended" to="$(arg heading_extended_topic)"/>
  </node>

</launch>
