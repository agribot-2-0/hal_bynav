@startuml bynav_socket

namespace bynav_socket {
  interface IParsingStrategy
  {
    + {abstract} getUint8(std::vector<uint8_t>::iterator it) : uint8_t
    + {abstract} getUint16(std::vector<uint8_t>::iterator it) : uint16_t
    + {abstract} getUint32(std::vector<uint8_t>::iterator it) : uint32_t
    + {abstract} getUint64(std::vector<uint8_t>::iterator it) : uint64_t
    + {abstract} getFloat(std::vector<uint8_t>::iterator it) : float
    + {abstract} getDouble(std::vector<uint8_t>::iterator it) : double
    + {abstract} getString(std::vector<uint8_t>::iterator begin_it, std::vector<uint8_t>::iterator end_it) : std::string
  }

  class LsbFirstParsingStrategy
  {
    + getUint8(std::vector<uint8_t>::iterator it) : uint8_t
    + getUint16(std::vector<uint8_t>::iterator it) : uint16_t
    + getUint32(std::vector<uint8_t>::iterator it) : uint32_t
    + getUint64(std::vector<uint8_t>::iterator it) : uint64_t
    + getFloat(std::vector<uint8_t>::iterator it) : float
    + getDouble(std::vector<uint8_t>::iterator it) : double
    + getString(std::vector<uint8_t>::iterator begin_it, std::vector<uint8_t>::iterator end_it) : std::string
  }

  class MsbFirstParsingStrategy
  {
    + getUint8(std::vector<uint8_t>::iterator it) : uint8_t
    + getUint16(std::vector<uint8_t>::iterator it) : uint16_t
    + getUint32(std::vector<uint8_t>::iterator it) : uint32_t
    + getUint64(std::vector<uint8_t>::iterator it) : uint64_t
    + getFloat(std::vector<uint8_t>::iterator it) : float
    + getDouble(std::vector<uint8_t>::iterator it) : double
    + getString(std::vector<uint8_t>::iterator begin_it, std::vector<uint8_t>::iterator end_it) : std::string
  }

  class Buffer
  {
    + std::vector<uint8_t> buffer_
    + std::size_t read_length_
    + Buffer()
    + Buffer(std::size_t size)
    + ~Buffer()
  }

  interface ISocket
  {
    + {abstract} open() : void
    + {abstract} close() : void
    + {abstract} connect() : void
    + {abstract} reconnect() : void
    + {abstract} read(Buffer& buffer) : void
  }

  interface IParser
  {
    - std::unordered_map<uint64_t, std::vector<std::function<void(IFrame&)>>> callback_map_
    # std::unique_ptr<IParsingStrategy> parsing_strategy_
    # std::unique_ptr<IFrameFactory> frame_factory_
    - {abstract} getId(std::vector<uint8_t>::iterator begin_it) : uint64_t
    - {abstract} checkCrc(std::vector<uint8_t>::iterator begin_it) : bool
    - {abstract} split(Buffer& buffer) : std::vector<std::pair<std::vector<uint8_t>::iterator, std::vector<uint8_t>::iterator>>
    # void callCallbacks(uint64_t id, IFrame& frame)
    + registerCallback(uint64_t id, const std::function<void(IFrame&)>&) : void
    + processBuffer(Buffer& buffer) : void
  }

  interface IFrameFactory
  {
    + {abstract} createFrame(uint64_t id) : IFrame
  }

  interface IFrame
  {
    + {abstract} parse(BufferSlice& slice, IParsingStrategy& strategy) : void
    + {abstract} checkCrc() : bool
  }

  class TcpSocket
  {
    - int socket_fd_
    - struct sockaddr_in server_address_
    - std::string ip_address_
    - uint16_t port_
    - uint16_t timeout_ms_
    + TcpSocket(std::string ip_address, uint16_t port, uint16_t timeout_ms)
    + ~TcpSocket()
    + open() : void
    + close() : void
    + connect() : void
    + reconnect() : void
    + read(Buffer& buffer) : void
  }

  class BynavParser
  {
    - getId(std::vector<uint8_t>::iterator begin_it) : uint64_t
    - checkCrc(std::vector<uint8_t>::iterator begin_it) : bool
    - split(Buffer& buffer) : std::vector<std::pair<std::vector<uint8_t>::iterator, std::vector<uint8_t>::iterator>>
  }

  interface BynavFrameFactory
  {
    + createFrame(uint64_t id) : IFrame
  }

  ' Bynav Frames
  enum SolutionStatus
  {

  }

  enum PositionStatus
  {

  }

  class BynavHeader
  {

  }

  class ExtendedSolutionStatus
  {

  }

  enum SolutionSource
  {

  }

  class BestGnssPosFrame
  {
    + parse(BufferSlice& slice, IParsingStrategy& strategy) : void
    + checkCrc() : bool
    - BynavHeader header_
    - SolutionStatus solution_status_
    - PositionStatus position_status_
    - double latitude_
    - double longitude_
    - double altitude_
    - float undulation_
    - float latitude_std_
    - float longitude_std_
    - float altitude_std_
    - string base_station_id
    - float differential_age_
    - float solution_age_
    - uint8_t tracked_satellites_n_
    - uint8_t solution_satellites_n_
    - uint8_t l1_solution_satellites_n_
    - uint8_t multifreq_solution_satellites_n_
    - ExtendedSolutionStatus extended_solution_status_
    - uint8_t galileo_beidou_signal_mask_
    - uint8_t gps_glonass_signal_mask_
    - uint32_t crc_
  }

  class HeadingFrame
  {
    + parse(BufferSlice& slice, IParsingStrategy& strategy) : void
    + checkCrc() : bool
    - BynavHeader header_
    - SolutionStatus solution_status_
    - PositionStatus position_status_
    - float baseline_length_
    - float heading_
    - float pitch_
    - float heading_std_
    - float pitch_std_
    - string base_station_id
    - uint8_t tracked_satellites_n_
    - uint8_t solution_satellites_n_
    - uint8_t satellites_above_elevation_n_
    - uint8_t l2_solution_satellites_n_
    - SolutionSource solution_source_
    - ExtendedSolutionStatus extended_solution_status_
    - uint8_t galileo_beidou_signal_mask_
    - uint8_t gps_glonass_signal_mask_
    - uint32_t crc_
  }

  class HalBynavNode
  {
    + run() : void
    - bestGnssPosFrameCallback(const IFrame&) : void
    - headingFrameCallback(const IFrame&) : void
    - std::unique_ptr<Buffer> buffer_
    - std::unique_ptr<IParser> parser_
    - std::unique_ptr<ISocket> socket_
    - std::unique_ptr<IParsingStrategy> parsing_strategy_
    - std::unique_ptr<IFrameFactory> frame_factory_
  }

  class LsbFirstParsingStrategy implements IParsingStrategy
  class MsbFirstParsingStrategy implements IParsingStrategy
  class HeadingFrame implements IFrame
  class BestGnssPosFrame implements IFrame
  class TcpSocket implements ISocket
  class BynavParser implements IParser
  class BynavFrameFactory implements IFrameFactory

  IParser ..> IFrame
  IParser ..> Buffer
  IParser ..> IParsingStrategy
  IFrame ..> IParsingStrategy
  HalBynavNode ..> IFrame
  IFrameFactory ..> IFrame
  IParser ..> IFrameFactory

  BestGnssPosFrame *-- SolutionStatus
  BestGnssPosFrame *-- PositionStatus
  BestGnssPosFrame *-- BynavHeader
  BestGnssPosFrame *-- ExtendedSolutionStatus
  HeadingFrame *-- SolutionStatus
  HeadingFrame *-- PositionStatus
  HeadingFrame *-- BynavHeader
  HeadingFrame *-- ExtendedSolutionStatus
  HeadingFrame *-- SolutionSource
  HalBynavNode o-- Buffer
  HalBynavNode o-- BynavParser
  HalBynavNode o-- TcpSocket
  HalBynavNode o-- LsbFirstParsingStrategy
  HalBynavNode o-- BynavFrameFactory
}

@enduml
